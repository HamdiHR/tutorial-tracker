{
  "name": "tutorial-tracker",
  "version": "0.40.1",
  "description": "Light local app to follow step-by-step tutorials: slides per step, progress dashboard, notes, edits.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "release": "node scripts/release.cjs",
    "check:version": "node scripts/check-version.cjs",
    "pretest": "node -e \"require('fs').existsSync('public/index.html')||require('child_process').execSync('node scripts/build.cjs',{stdio:'inherit'})\"",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "build": "node scripts/build.cjs",
    "import": "node --disable-warning=ExperimentalWarning server/cli.js import",
    "export": "node --disable-warning=ExperimentalWarning server/cli.js export",
    "build:single": "node scripts/build.cjs --single",
    "perf": "node scripts/perf-baseline.cjs",
    "build:content": "node --disable-warning=ExperimentalWarning scripts/build-content.js",
    "build:engine": "node scripts/build-engine.cjs",
    "build:hosted": "node scripts/migrate-hosted.js && node scripts/build.cjs && node --disable-warning=ExperimentalWarning scripts/build-content.js && node scripts/build-engine.cjs",
    "test:hosted": "bash hosted/test/sql-test.sh && node --disable-warning=ExperimentalWarning --test test/hosted.test.js",
    "test:e2e": "node test/e2e/run.cjs",
    "test:all": "bash hosted/test/sql-test.sh && node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "esbuild": "^0.28.0",
    "highlight.js": "^11.11.0",
    "marked": "^18.0.0",
    "pg": "^8.13.0",
    "playwright": "^1.49.0"
  }
}
